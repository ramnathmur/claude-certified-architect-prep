.vercel

# Claude Code worktrees — each is a full checkout of this repo (~19MB).
# Git skips them anyway (they carry their own .git), but never let them in.
.claude/worktrees/

# Third-party mock-exam repos cloned for reference. This is a nested git
# repository containing further nested repos; adding it would commit a
# broken gitlink, not the files. Kept locally, out of version control.
mock exams from repos/

# Python bytecode cache — regenerates on its own, never source.
__pycache__/
*.pyc

# A crawled mirror of a third-party certification-guide site, kept locally
# for reference. This repo is public; excluded 2026-08-24 on Ram's call
# rather than republish someone else's site content.
CCAR-F - Claude Certified Architect Foundations/Outputs/ccg-mirror/
